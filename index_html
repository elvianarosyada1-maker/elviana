 if(v==Q.c.ans){b.classList.add('ok');sfx.good();Q.ok++;Q.sc+=10;S.score+=10;hud();$('qS').textContent=Q.sc;$('qH').textContent='⭐'.repeat(Q.ok)+'☆'.repeat(TOT-Q.ok);$('qP').textContent='Benar '+Q.ok+' dari '+TOT;$('qF').innerHTML='🎉 Selamat! Jawabanmu benar! +10 🪙';setTimeout(nextQ,1100)}
 else{Q.bad++;b.classList.add('no','shk');sfx.bad();all.forEach(x=>{if(+x.dataset.v==Q.c.ans)x.classList.add('ok')});$('qF').innerHTML='💭 Belum tepat. Jawaban yang benar: <b>'+Q.c.ans+'</b>.<br><span class="text-base">'+(Q.c.tip||'Hitung balok puluhan dan satuan dengan teliti.')+' Ayo coba soal baru!</span>';setTimeout(nextQ,3200)}};
shield=function(){if(Q.hs<1||Q.lock)return;Q.hs--;$('nK').textContent=Q.hs;$('bK').disabled=Q.hs<1;sfx.shield();$('qF').innerHTML='👑 Petunjuk Raja: '+(Q.c.tip||'Hitung balok puluhan 🟥 dan satuan 🟦 dengan teliti.')};
endQuiz=function(){S.cry.add(Q.lv);S.unlocked=Math.max(S.unlocked,Math.min(5,Q.lv+1));sfx.win();hud();const all=S.cry.size>=5;
 pop(`<div class='text-6xl bnc'>💎</div><h3 class='text-2xl font-extrabold'>Kristal ${Q.lv} didapat!</h3><p class='font-bold'>Skor kuis: ${Q.sc} 🪙 · Soal diganti karena salah: ${Q.bad} kali</p><p class='font-bold'>${all?'Semua kristal terkumpul! Ambil sertifikatmu!':Q.lv<5?'Wilayah berikutnya terbuka!':'Coba juga Arena Permainan!'}</p>`);go(all?'end':'map');if(all)fillEnd()};
showGuide=function(){pop("<h3 class='text-2xl font-extrabold'>📖 Panduan Bermain</h3><ul class='text-left font-bold mt-2 list-disc pl-6'><li>Buka wilayah, klik Pelajari Materi dulu.</li><li>Di kuis, kamu harus menjawab 6 soal dengan benar. Tiap benar dapat 🪙 dan ⭐.</li><li>Kalau salah, soalnya langsung diganti. Jadi hitung dulu, jangan asal tebak!</li><li>🧙 Penyihir menyingkirkan 2 jawaban salah.</li><li>👑 Petunjuk Raja memberi petunjuk cara menghitung.</li><li>Selesaikan kuis untuk mendapat 💎 dan membuka wilayah baru.</li></ul>")};
/* kartu pasangan terbuka */
startMemory=function(){go('mem');Mem={sel:null,matched:0,tries:0,lock:false};$('memMatch').textContent=0;$('memTries').textContent=0;$('memF').textContent='Soal ada di kiri, jawaban di kanan. Hitung dulu, lalu pasangkan!';
 const qs=[],used=new Set();let i=0;while(i<4){const o=G(r(2,4));if(used.has(o.ans))continue;used.add(o.ans);qs.push({id:i,q:o.q,a:o.ans});i++}
 const an=sh(qs.map(x=>({id:x.id,t:x.a})));
 $('memGrid').innerHTML=qs.map((x,k)=>`<button class='opt !text-2xl' style='background:linear-gradient(#fff6b0,#ffe066)' data-t='q' data-id='${x.id}' onclick='memClick(this)'>${x.q}</button><button class='opt !text-3xl' style='background:linear-gradient(#c8f7c5,#7bdc72)' data-t='a' data-id='${an[k].id}' onclick='memClick(this)'>${an[k].t}</button>`).join('')};
memClick=function(b){if(Mem.lock||b.classList.contains('ok'))return;sfx.click();const s=Mem.sel;
 if(!s||s.dataset.t==b.dataset.t){if(s)s.style.outline='';b.style.outline='5px solid #6d28d9';Mem.sel=b;return}
 Mem.tries++;$('memTries').textContent=Mem.tries;s.style.outline='';Mem.sel=null;
 if(s.dataset.id==b.dataset.id){sfx.good();[s,b].forEach(x=>{x.classList.add('ok');x.style.background='linear-gradient(#b8f7a0,#53c93b)';x.style.opacity='.75';x.disabled=true});Mem.matched++;$('memMatch').textContent=Mem.matched;$('memF').textContent='✅ Betul!';
  if(Mem.matched>=4){sfx.win();S.score+=40;hud();$('memF').textContent='🎉 Hebat! Semua pasangan cocok! +40 🪙'}}
 else{sfx.bad();Mem.lock=true;$('memF').textContent='💭 Belum cocok, hitung lagi ya!';[s,b].forEach(x=>{x.style.outline='5px solid #ef4444';x.classList.add('shk')});setTimeout(()=>{[s,b].forEach(x=>{x.style.outline='';x.classList.remove('shk')});Mem.lock=false},700)}};
/* balapan kilat */
let Race={timer:null};
function stopRace(){clearInterval(Race.timer)}
function startRace(){stopRace();go('race');Race={time:30,score:0,timer:null,cur:null,lock:false};$('raceTime').textContent=30;$('raceScore').textContent=0;nextRace();
 Race.timer=setInterval(()=>{Race.time--;$('raceTime').textContent=Race.time;if(Race.time<=0){stopRace();sfx.win();S.score+=Race.score;hud();pop(`<div class='text-6xl bnc'>⏱️</div><h3 class='text-2xl font-extrabold'>Waktu habis!</h3><p class='font-bold'>Kamu mengumpulkan <b>${Race.score} 🪙</b> dalam 30 detik!</p>`);go('hub')}},1000)}
function nextRace(){Race.cur=G(r(1,4));$('raceQ').textContent=Race.cur.q;$('raceO').innerHTML=Race.cur.o.map(v=>`<button class='opt' onclick='ansRace(this,${v})'>${v}</button>`).join('')}
function ansRace(b,v){if(Race.lock)return;if(v==Race.cur.ans){sfx.good();Race.score+=10;$('raceScore').textContent=Race.score;b.classList.add('ok');Race.lock=true;setTimeout(()=>{Race.lock=false;nextRace()},250)}else{sfx.bad();b.classList.add('no');Race.lock=true;setTimeout(()=>{b.classList.remove('no');Race.lock=false},300)}}
/* daftar slide */
const P=t=>`<p class="font-bold text-lg mb-2">${t}</p>`,LST=a=>'<ol class="text-left font-bold list-decimal pl-8 mt-2 inline-block">'+a.map(x=>'<li>'+x+'</li>').join('')+'</ol>';
function SL(lv){const ch={t:'Tantangan',h:'⚡ Tantangan Kilat',b:chal};return [
 [{t:'Kenali',h:'🌳 Puluhan dan Satuan',b:()=>P('Di Hutan Angka, 10 buah 🟦 diikat jadi 1 batang 🟥. Batang disebut <b>puluhan</b>. Buah lepas disebut <b>satuan</b>.')+tenTo()+'<input type="range" min="0" max="99" value="46" class="w-64" oninput="sl2(this.value)"><div id="dm"></div>',i:()=>sl2(46)},
  {t:'Kalkulator',h:'🧮 Kalkulator Balok Ajaib',b:()=>P('Tekan tombol. Coba tekan +1 satuan sampai 10 dan lihat keajaiban!')+counter('a'),i:()=>paintCt('a')},
  {t:'Bentuk Angka',h:'🎯 Bentuk Angka Target',b:()=>{const g=r(11,99);return P(`Susun angka <b class="text-4xl">${g}</b> memakai balok!`)+counter('b',g)+'<button class="gold mt-3" onclick="chkT()">Cek ✔</button><div id="tg" class="font-bold mt-2 text-lg"></div>'},i:()=>paintCt('b')},ch],
 [{t:'Kenali',h:'🌉 Aturan Menyimpan',b:()=>P('Jembatan hanya kuat menahan 9 satuan. Kalau satuan jadi 10, tukar dengan 1 puluhan lalu <b>simpan</b> ke kiri!')+tenTo()+LST(['Jumlahkan <b>satuan</b> dulu.','Satuan 10 atau lebih? Simpan 1 puluhan.','Jumlahkan <b>puluhan</b> plus simpanan.'])},
  {t:'Kalkulator',h:'🧮 Kalkulator Penjumlahan Menyimpan',b:()=>P('Ketik dua angka atau tekan Acak. Lalu lihat langkahnya satu per satu.')+colcalc('+'),i:()=>cStart('+')},ch],
 [{t:'Kenali',h:'⛰️ Aturan Meminjam',b:()=>P('Di gua gelap, satuan atas kadang kurang. Pinjam 1 puluhan 🟥, ubah jadi 10 satuan 🟦!')+'<div class="my-2"><span class="bt"></span> <b class="text-2xl">=</b> '+'<span class="bo"></span>'.repeat(10)+'</div>'+LST(['Satuan atas lebih kecil? <b>Pinjam</b> 1 puluhan.','Satuan atas jadi tambah 10, lalu dikurangi.','Puluhan atas jadi berkurang 1, lalu dikurangi.'])},
  {t:'Kalkulator',h:'🧮 Kalkulator Pengurangan Meminjam',b:()=>P('Angka pertama harus lebih besar. Tekan Acak untuk soal meminjam!')+colcalc('−'),i:()=>cStart('−')},ch],
 [{t:'Kenali',h:'🔮 Rahasia Penyihir',b:()=>P('Menambah 10 itu mudah, hanya puluhan yang naik 1! Penyihir memakai itu untuk menambah 9, 8, atau 11.')+LST(['9 = 10 − 1, jadi tambah 10 lalu kurangi 1.','8 = 10 − 2, jadi tambah 10 lalu kurangi 2.','Mengurangi 9: kurangi 10 lalu tambah 1.'])},
  {t:'Kalkulator',h:'🧙 Kalkulator Trik Kilat',b:()=>P('Pilih angka dan trik. Lihat lompatan sihirnya!')+trickUI(),i:()=>tRun('+9')},ch],
 [{t:'Kenali',h:'🏰 Empat Langkah Soal Cerita',b:()=>P('Pahlawan membaca cerita dengan teliti.')+LST(['<b>Baca</b> soal dan cari angkanya.','<b>Pilih</b> operasi dari kata kunci.','<b>Hitung</b> dengan cara yang sudah dipelajari.','<b>Jawab</b> lengkap dengan bendanya.'])+'<div class="grid grid-cols-2 gap-3 mt-3 font-bold"><div class="rounded-2xl bg-green-200 p-2">➕ dapat lagi, digabung, semuanya</div><div class="rounded-2xl bg-red-200 p-2">➖ diberikan, dimakan, sisanya</div></div>'},
  {t:'Kalkulator',h:'🧮 Kalkulator Soal Cerita',b:()=>P('Susun ceritamu sendiri, lalu lihat jawabannya!')+storyUI(),i:()=>stRun()},ch]][lv-1]}
</script>
