 <div class="wood inline-block px-8 py-3 -mt-2"><h2 class="text-3xl font-extrabold" style="color:#ffe46b">Peta Kerajaan Aritmatika</h2><div class="text-sm font-bold">Pilih wilayah yang akan kamu jelajahi! ⭐</div></div></div>
 <div id="map" class="relative mt-3 rounded-3xl overflow-hidden border-4 border-yellow-300" style="height:600px;background:radial-gradient(circle at 85% 8%,#fff6a8 0 5%,transparent 6%),linear-gradient(#8fd8ff 0,#d4f3ff 25%,#7fd35c 25%,#4cae45 100%);box-shadow:0 8px 0 #2d7a28">
  <div class="absolute flo text-5xl" style="left:8%;top:3%">☁️</div><div class="absolute flo text-6xl" style="left:55%;top:5%;animation-delay:1s">☁️</div>
  <div class="absolute" style="left:-5%;top:60%;width:110%;height:50px;background:#4cb8ff;border-radius:50%;transform:rotate(-8deg);opacity:.85"></div>
  <svg class="absolute inset-0 w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none"><polyline points="22,24 72,22 74,50 26,52 50,80" fill="none" stroke="#fff0b0" stroke-width="5" stroke-dasharray="1 9" stroke-linecap="round" vector-effect="non-scaling-stroke" style="stroke-width:6"/></svg>
  <div id="nodes"></div>
 </div>
 <div class="flex flex-wrap justify-center gap-3 mt-4">
  <button class="gold" onclick="showGoal()">🎯 Tujuan Pembelajaran</button>
  <button class="gold" onclick="libOpen()">📚 Perpustakaan Materi</button><button class="gold" onclick="go('hub')">🎮 Arena Permainan &amp; Versus</button><button class="gold" onclick="showGuide()">📖 Panduan Bermain</button>
  <button class="gold" id="certBtn" onclick="endScr()" disabled>🏆 Sertifikat</button>
 </div>
</section>

<!-- REGION -->
<section id="s-reg" class="scr hidden text-center pt-6">
 <div class="crown">👑</div><div class="wood inline-block px-8 py-4 -mt-2"><h2 id="rT" class="text-3xl font-extrabold" style="color:#ffe46b"></h2></div>
 <div id="rE" class="text-8xl my-3 flo"></div>
 <div class="scroll max-w-md mx-auto p-4 font-bold" id="rD"></div>
 <div class="flex flex-col items-center gap-4 mt-5" id="rB"></div>
 <button class="brown mt-6" onclick="go('map')">← Kembali ke Peta</button>
</section>

<!-- LEARN -->
<section id="s-learn" class="scr hidden">
 <div class="wood px-6 py-3 text-center mt-4"><h2 id="lT" class="text-2xl font-extrabold" style="color:#ffe46b"></h2></div>
 <div class="scroll p-5 mt-4 text-center">
  <div id="lV" class="min-h-[160px] flex flex-wrap items-center justify-center gap-3"></div>
  <div id="lX" class="text-xl font-bold mt-3 min-h-[3rem]"></div>
  <div id="lCtl" class="mt-3"></div>
 </div>
 <div class="text-center mt-4 flex justify-center gap-3 flex-wrap"><button class='brown' onclick='go(LF)'>← Kembali</button><button class='gold' onclick='startQuiz(cur)'>⚔️ Main Kuis</button></div>
</section>

<!-- QUIZ -->
<section id="s-quiz" class="scr hidden">
 <div class="wood flex flex-wrap justify-between items-center px-5 py-2 mt-4 gap-2">
  <div class="text-2xl" id="qH"></div><div class="font-extrabold" id="qP"></div><div class="font-extrabold text-xl">🪙 <span id="qS">0</span></div></div>
 <div class="scroll p-5 mt-4 text-center">
  <div id="qV" class="min-h-[40px] mb-2"></div>
  <div id="qQ" class="text-3xl font-extrabold mb-4"></div>
  <div id="qO" class="grid grid-cols-2 gap-4 max-w-lg mx-auto"></div>
  <div id="qF" class="mt-4 font-extrabold text-xl min-h-[2rem]"></div>
 </div>
 <div class="flex justify-center gap-3 mt-4 flex-wrap">
  <button class="gold" id="bW" onclick="wiz()">🧙 Bantuan Penyihir (<span id="nW">2</span>)</button>
  <button class="gold" id="bK" onclick="shield()">🛡️ Perisai Raja (<span id="nK">1</span>)</button>
  <button class="brown" onclick="go('reg')">Keluar</button></div>
</section>

<!-- VERSUS -->
<section id="s-vs" class="scr hidden">
 <div class="wood px-6 py-3 text-center mt-4"><h2 class="text-2xl font-extrabold" style="color:#ffe46b">⚔️ Adu Cepat Istana Kristal</h2><div id="vR" class="font-bold"></div></div>
 <div class='max-w-xl mx-auto mt-3'><div class='relative h-9 rounded-full overflow-hidden border-2 border-yellow-300 bg-slate-900 flex' style='box-shadow:0 0 18px #fde047'><div id='vBar0' class='h-full transition-all duration-500' style='width:50%;background:linear-gradient(90deg,#22d3ee,#2563eb)'></div><div id='vBar1' class='h-full transition-all duration-500' style='width:50%;background:linear-gradient(270deg,#f472b6,#dc2626)'></div><div class='absolute inset-0 flex items-center justify-center text-sm font-extrabold text-white'>⚔️ TARIK TAMBANG KRISTAL ⚔️</div></div><div class='h-2 mt-1 rounded bg-white/20'><div id='vTm' class='h-2 rounded bg-yellow-300' style='width:100%'></div></div></div>
 <div class="scroll p-4 mt-3 text-center text-3xl font-extrabold" id="vQ"></div>
 <div class="grid md:grid-cols-2 gap-3 mt-3">
  <div class="rounded-3xl p-3 border-4 border-blue-600" style="background:linear-gradient(#cfe4ff,#7fb2ff)"><div class="text-center font-extrabold text-xl text-blue-900">🔵 Kesatria Biru: <span id="v0">0</span> ⚔️ <span id="c0"></span></div><div class="grid grid-cols-2 gap-3 mt-2" id="p0"></div></div>
  <div class="rounded-3xl p-3 border-4 border-red-600" style="background:linear-gradient(#ffd0d0,#ff8c8c)"><div class="text-center font-extrabold text-xl text-red-900">🔴 Kesatria Merah: <span id="v1">0</span> ⚔️ <span id="c1"></span></div><div class="grid grid-cols-2 gap-3 mt-2" id="p1"></div></div>
 </div>
 <div id="vF" class="text-center font-extrabold text-2xl mt-3 min-h-[2.5rem]"></div>
 <div class='text-center mt-2'><button class='brown' onclick="vsStop();go('hub')">← Keluar ke Arena</button></div>
</section>

<section id='s-hub' class='scr hidden text-center pt-4'><div class='crown'>👑</div><div class='wood inline-block px-8 py-3 -mt-2'><h2 class='text-3xl font-extrabold' style='color:#ffe46b'>🎮 Arena Permainan Kerajaan</h2><div class='text-sm font-bold'>Pilih mode tantangan yang ingin kamu mainkan!</div></div>
<div class='grid md:grid-cols-3 gap-4 mt-6 max-w-4xl mx-auto'>
<div class='scroll p-5 flex flex-col justify-between'><div class='text-6xl flo mb-2'>⚔️</div><h3 class='text-2xl font-extrabold'>Duel Versus 2 Pemain</h3><p class='font-bold text-sm my-2'>1 layar, 2 kesatria! Tarik tambang poin, combo 🔥, ronde kristal ×2, dan KO!</p><button class='gold mt-3' onclick='startVs()'>Adu Cepat ▶</button></div>
<div class='scroll p-5 flex flex-col justify-between'><div class='text-6xl flo mb-2'>🎴</div><h3 class='text-2xl font-extrabold'>Kartu Memori</h3><p class='font-bold text-sm my-2'>Pasangkan soal dengan jawaban yang pas!</p><button class='gold mt-3' onclick='startMemory()'>Pasang Kartu ▶</button></div>
<div class='scroll p-5 flex flex-col justify-between'><div class='text-6xl flo mb-2'>⚡</div><h3 class='text-2xl font-extrabold'>Balapan Kilat 30 Detik</h3><p class='font-bold text-sm my-2'>Jawab sebanyak mungkin soal sebelum waktu habis!</p><button class='gold mt-3' onclick='startRace()'>Mulai Balapan ▶</button></div></div>
<div class='mt-6'><button class='brown' onclick="go('map')">← Kembali ke Peta</button></div></section>
<section id='s-mem' class='scr hidden'><div class='wood px-6 py-3 text-center mt-4'><h2 class='text-2xl font-extrabold' style='color:#ffe46b'>🎴 Kartu Memori Matematika</h2><div class='font-bold'>Semua kartu terbuka! Ketuk 1 soal 🟨, lalu ketuk jawabannya 🟩</div></div>
<div class='scroll p-3 mt-3 flex justify-between items-center font-extrabold max-w-2xl mx-auto'><div>Cocok: <span id='memMatch' class='text-2xl'>0</span>/4</div><div>Percobaan: <span id='memTries' class='text-2xl'>0</span></div></div>
<div id='memGrid' class='grid grid-cols-2 gap-3 max-w-xl mx-auto mt-4'></div><div id='memF' class='text-center font-extrabold text-xl mt-3 min-h-[2rem]'></div>
<div class='text-center mt-4'><button class='gold' onclick='startMemory()'>🎲 Kartu Baru</button> <button class='brown' onclick="go('hub')">← Keluar</button></div></section>
<section id='s-race' class='scr hidden'><div class='wood px-6 py-3 text-center mt-4'><h2 class='text-2xl font-extrabold' style='color:#ffe46b'>⚡ Balapan Kilat 30 Detik</h2><div class='font-bold'>Setiap jawaban benar +10 🪙. Salah? Coba lagi cepat!</div></div>
<div class='scroll p-3 mt-3 flex justify-around font-extrabold max-w-xl mx-auto text-2xl'><div>⏱️ <span id='raceTime'>30</span>s</div><div>🪙 <span id='raceScore'>0</span></div></div>
<div class='scroll p-6 mt-4 text-center max-w-xl mx-auto'><div id='raceQ' class='text-4xl font-extrabold mb-6'></div><div id='raceO' class='grid grid-cols-2 gap-4'></div></div>
<div class='text-center mt-4'><button class='brown' onclick="stopRace();go('hub')">← Keluar</button></div></section>
<section id='s-lib' class='scr hidden'><div class='wood px-6 py-3 text-center mt-4'><h2 class='text-3xl font-extrabold' style='color:#fde047'>📚 Perpustakaan Materi</h2><div class='font-bold'>Belajar kapan saja, tanpa perlu main kuis dulu!</div></div><div id='libG' class='grid md:grid-cols-2 gap-4 mt-4'></div><div class='text-center mt-4'><button class='brown' onclick="go('map')">← Kembali ke Peta</button></div></section>
<!-- END -->
<section id="s-end" class="scr hidden text-center pt-4">
 <div class="cert p-6 max-w-2xl mx-auto">
  <div class="crown">👑</div>
  <h2 class="text-3xl font-extrabold">Sertifikat Pahlawan Matematika</h2>
  <p class="mt-2 font-bold">Dengan bangga diberikan kepada</p>
  <div id="eN" class="text-5xl font-extrabold my-2" style="color:#c2410c"></div>
  <p class="font-bold">Kelas <span id="eC"></span> · <span id="eS"></span></p>
  <p class="mt-2 font-bold">atas keberhasilan menaklukkan Kerajaan Aritmatika dan mengumpulkan semua kristal ajaib.</p>
  <div class="grid grid-cols-3 gap-2 mt-4 text-center font-extrabold">
   <div class="scroll p-2">💎<div id="eK" class="text-2xl"></div>Kristal</div>
   <div class="scroll p-2">🪙<div id="eP" class="text-2xl"></div>Total Skor</div>
   <div class="scroll p-2">⏱️<div id="eT" class="text-2xl"></div>Waktu</div></div>
  <div id="eM" class="mt-3 font-bold"></div>
 </div>
 <div class="flex gap-3 justify-center mt-4 flex-wrap"><button class="gold" onclick="window.print()">🖨️ Cetak</button><button class="gold" onclick="go('map')">🗺️ Kembali ke Peta</button></div>
</section>
</main>
<div id="pop" class="hidden"><div id="popB" class="scroll p-6 max-w-md w-full text-center pop"></div></div>

<script>
const $=id=>document.getElementById(id),r=(a,b)=>a+Math.floor(Math.random()*(b-a+1)),sh=a=>a.sort(()=>Math.random()-.5);
const S={name:'',cls:'',school:'',unlocked:1,cry:new Set(),score:0,t0:0};
let cur=1,Q={},V={};
/* ---------- AUDIO ---------- */
let AC,muted=false,bg=null,st=0;
function ac(){if(!AC)AC=new(window.AudioContext||window.webkitAudioContext)();if(AC.state=='suspended')AC.resume()}
function tone(f,d,ty='square',v=.08,dl=0){if(!AC||muted)return;const t=AC.currentTime+dl,o=AC.createOscillator(),g=AC.createGain();o.type=ty;o.frequency.setValueAtTime(f,t);g.gain.setValueAtTime(v,t);g.gain.exponentialRampToValueAtTime(.001,t+d);o.connect(g);g.connect(AC.destination);o.start(t);o.stop(t+d)}
const sfx={click:()=>tone(660,.07,'square',.06),good:()=>{tone(988,.15,'sine',.18);tone(1319,.35,'sine',.18,.1)},
 bad:()=>{if(!AC||muted)return;const t=AC.currentTime,o=AC.createOscillator(),g=AC.createGain();o.type='sawtooth';o.frequency.setValueAtTime(380,t);o.frequency.exponentialRampToValueAtTime(110,t+.4);g.gain.setValueAtTime(.12,t);g.gain.exponentialRampToValueAtTime(.001,t+.45);o.connect(g);g.connect(AC.destination);o.start(t);o.stop(t+.5)},
 win:()=>[523,659,784,1047,784,1047,1319].forEach((f,i)=>tone(f,.3,'triangle',.15,i*.13))};
const mel=[523,659,784,659,587,698,880,698,523,659,784,1047,988,784,659,587],bass=[131,131,175,196];
function bgm(){if(bg)return;bg=setInterval(()=>{tone(mel[st%16],.22,'triangle',.05);if(st%4==0)tone(bass[(st>>2)%4],.5,'sine',.07);st++},250)}
function toggleMute(){muted=!muted;$('mb').textContent=muted?'🔇':'🔊'}
document.addEventListener('click',e=>{if(e.target.closest('button')){ac();sfx.click()}});
/* ---------- NAV ---------- */
function go(id){document.querySelectorAll('.scr').forEach(e=>e.classList.add('hidden'));$('s-'+id).classList.remove('hidden');$('hud').classList.toggle('hidden',id=='intro');if(id=='map')drawMap();hud();scrollTo(0,0)}
function home(){go('map')}
function hud(){$('hN').textContent=S.name;$('hC').textContent=S.cls;$('hS').textContent=S.school;$('hCoin').textContent=S.score;$('hCry').textContent=S.cry.size}
function pop(h){$('popB').innerHTML=h+'<div class="mt-4"><button class="gold" onclick="closePop()">Siap!</button></div>';$('pop').classList.remove('hidden')}
function closePop(){$('pop').classList.add('hidden')}
