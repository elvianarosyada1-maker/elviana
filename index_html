<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Petualangan Kerajaan Matematika</title>
<script src="https://cdn.tailwindcss.com/3.4.17"></script>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&display=swap" rel="stylesheet">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:inherit}
html,body{min-height:100%;margin:0}
body{font-family:'Baloo 2','Trebuchet MS',sans-serif;color:#4a2c0f;background:linear-gradient(#7ccdf5 0,#c5ecff 30%,#8fdc6b 30%,#4fb54a 100%) fixed;overflow-x:hidden}
.wood{background:linear-gradient(180deg,#a86a35,#7a4519 60%,#6a3a14);border:4px solid #ffd23f;border-radius:22px;box-shadow:0 8px 0 #4a2708,0 14px 22px rgba(0,0,0,.35),inset 0 3px 0 rgba(255,255,255,.25);color:#fff7d6}
.scroll{background:linear-gradient(#fff3cf,#f5deaa);border:3px solid #c98f3e;border-radius:18px;box-shadow:0 5px 0 #a8742a,0 8px 14px rgba(0,0,0,.25);color:#4b2a7a}
.gold{background:linear-gradient(#ffe46b,#f9b81a 55%,#e69a05);border:3px solid #fff3a8;border-radius:999px;box-shadow:0 6px 0 #a96a00,0 12px 18px rgba(0,0,0,.3),inset 0 3px 6px rgba(255,255,255,.7);color:#5a2d00;font-weight:800;padding:10px 26px;cursor:pointer;transition:transform .12s,box-shadow .12s}
.gold:hover{transform:translateY(-2px) scale(1.04)}
.gold:active{transform:translateY(5px);box-shadow:0 1px 0 #a96a00}
.gold:disabled{filter:grayscale(1);opacity:.6;cursor:not-allowed}
.brown{background:linear-gradient(#a86a35,#6a3a14);border:3px solid #e8b45a;color:#fff7d6;border-radius:999px;padding:6px 18px;font-weight:700;box-shadow:0 4px 0 #3c1f08;cursor:pointer}
.crown{font-size:3rem;filter:drop-shadow(0 0 10px #ffd23f);animation:glow 2s infinite alternate}
@keyframes glow{to{filter:drop-shadow(0 0 22px #fff06a);transform:scale(1.1)}}
@keyframes flo{50%{transform:translateY(-12px)}}
@keyframes bnc{0%,100%{transform:translateY(0)}40%{transform:translateY(-18px)}60%{transform:translateY(0)}70%{transform:translateY(-6px)}}
@keyframes shk{25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
@keyframes pop{from{transform:scale(.5);opacity:0}}
.flo{animation:flo 3s ease-in-out infinite}.bnc{animation:bnc 1.6s infinite}.shk{animation:shk .35s}.pop{animation:pop .3s}
.inp{width:100%;padding:10px 14px;border-radius:14px;border:3px solid #c98f3e;background:#fffbea;color:#4a2c0f;font:inherit;font-weight:700;font-size:1.1rem}
.opt{font-size:1.9rem;font-weight:800;padding:14px;border-radius:18px;background:linear-gradient(#fff,#ffeaa8);border:4px solid #e8b45a;box-shadow:0 5px 0 #b57d1c;cursor:pointer;color:#4a2c0f;transition:transform .1s}
.opt:hover:not(:disabled){transform:scale(1.05)}
.opt.ok{background:linear-gradient(#b8f7a0,#53c93b);border-color:#2b8a1c}
.opt.no{background:linear-gradient(#ffb3b3,#f05151);border-color:#a82020;opacity:.7}
.opt:disabled{cursor:default}
.bt{display:inline-block;width:14px;height:54px;margin:2px;border-radius:4px;background:linear-gradient(#ff7b7b,#c0392b);box-shadow:inset 0 0 0 2px rgba(255,255,255,.3)}
.bo{display:inline-block;width:14px;height:14px;margin:2px;border-radius:4px;background:linear-gradient(#6cb2ff,#2563eb)}
.node{position:absolute;transform:translate(-50%,-50%);text-align:center;width:140px;cursor:pointer}
.node .em{font-size:3.4rem;filter:drop-shadow(0 6px 4px rgba(0,0,0,.35))}
.hidden{display:none!important}
#pop{position:fixed;inset:0;background:rgba(30,10,60,.6);z-index:50;display:flex;align-items:center;justify-content:center;padding:16px}
.cert{background:#fffbe8;border:10px double #d9a31c;border-radius:12px;color:#4b2a7a;box-shadow:0 10px 30px rgba(0,0,0,.35)}
@media print{body *{visibility:hidden}.cert,.cert *{visibility:visible}.cert{position:absolute;left:0;top:0;width:100%}}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}
body{color:#eaf2ff;background:radial-gradient(circle at 20% 0,#3b2a8f,#0b0f2e 65%) fixed}
.wood{background:linear-gradient(135deg,rgba(255,255,255,.16),rgba(255,255,255,.04));backdrop-filter:blur(14px);border:2px solid #67e8f9;box-shadow:0 0 22px rgba(103,232,249,.45),inset 0 0 18px rgba(255,255,255,.08);color:#fff}
.scroll{background:rgba(24,18,70,.62);backdrop-filter:blur(12px);border:2px solid #c084fc;box-shadow:0 0 20px rgba(192,132,252,.4);color:#eaf2ff}
.bg-white\/70,.bg-white\/60,.bg-green-200,.bg-red-200{color:#2b1b6b}
.node .em{display:block;transition:transform .2s}.node:hover .em{transform:scale(1.15) rotate(-4deg)}
#map polyline{stroke:#67e8f9;filter:drop-shadow(0 0 5px #22d3ee)}
.av{transition:transform .15s}.av:hover{transform:scale(1.15)}
</style>
</head>
<body>
<div id="hud" class="hidden sticky top-0 z-40 p-2">
 <div class="wood flex flex-wrap items-center justify-between gap-2 px-4 py-2 !rounded-2xl">
